#Copy this file to .env and fill in your values. Never commit .env
PORT=3000
#Use web01 on Web01 and web02 on Web02 so the load balancer test shows who answered
SERVER_NAME=web01
#Seconds to keep rates in memory (43200 = 12 hrs)
CACHE_TTL_SECONDS=43200
#Free key from https://www.exchangerate-api.com (leave empty for keyless mode)
EXCHANGE_API_KEY=